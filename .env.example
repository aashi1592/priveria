# ============================================
# DPIA Platform - Environment Variables
# ============================================

# ---------------------------------------------
# Core Configuration (Required)
# ---------------------------------------------
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# ---------------------------------------------
# Enterprise Features (Optional)
# ---------------------------------------------
# Set to 'true' to enable enterprise features
# Requires valid enterprise license
VITE_ENTERPRISE_ENABLED=false

# Enterprise license key (obtain from sales)
VITE_LICENSE_KEY=

# Organization ID for license validation
VITE_ORGANIZATION_ID=

# ---------------------------------------------
# AI Features (Enterprise Only)
# ---------------------------------------------
# Lovable AI API key (for AI-powered features)
LOVABLE_API_KEY=

# Alternative: OpenAI API key
OPENAI_API_KEY=

# ---------------------------------------------
# GRC Integrations (Enterprise Only)
# ---------------------------------------------
# OneTrust Integration
ONETRUST_API_KEY=
ONETRUST_ORG_ID=
ONETRUST_BASE_URL=https://app.onetrust.com/api

# ServiceNow Integration
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# ---------------------------------------------
# Development Settings
# ---------------------------------------------
# Set to 'development' for local development
NODE_ENV=production

# Enable debug logging
DEBUG=false

# ---------------------------------------------
# Production Settings
# ---------------------------------------------
# Your production domain
VITE_APP_URL=https://yourdomain.com

# Analytics (optional)
VITE_ANALYTICS_ID=

# ---------------------------------------------
# Notes
# ---------------------------------------------
# 1. Copy this file to .env and fill in your values
# 2. Never commit .env to version control
# 3. Community edition works with just VITE_SUPABASE_* variables
# 4. Enterprise features require VITE_LICENSE_KEY
# 5. Contact enterprise@yourcompany.com for license keys
